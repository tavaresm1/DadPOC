@page "/customer/{CustomerId:int}"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav

@if (customer == null)
{
    <p>Loading...</p>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Customers</a></li>
            <li class="breadcrumb-item active">@customer.FirstName @customer.LastName</li>
        </ol>
    </nav>

    <div class="card mb-4">
        <div class="card-header">
            <h4>@customer.FirstName @customer.LastName</h4>
        </div>
        <div class="card-body">
            <p><strong>Email:</strong> @customer.Email</p>
            <p><strong>Phone:</strong> @(customer.Phone ?? "—")</p>
            <p><strong>Customer since:</strong> @customer.CreatedAt.ToString("yyyy-MM-dd")</p>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Orders</h4>
        <button class="btn btn-primary" @onclick="ShowAddOrderForm">Add Order</button>
    </div>

    @if (showOrderForm)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@(editingOrder.Id == 0 ? "New Order" : "Edit Order")</h5>
                <EditForm Model="editingOrder" OnValidSubmit="SaveOrder">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />
                    <div class="row mb-2">
                        <div class="col-md-4">
                            <label class="form-label">Description</label>
                            <InputText class="form-control" @bind-Value="editingOrder.Description" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Amount</label>
                            <InputNumber class="form-control" @bind-Value="editingOrder.Amount" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Order Date</label>
                            <InputDate class="form-control" @bind-Value="editingOrder.OrderDate" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <InputSelect class="form-select" @bind-Value="editingOrder.Status">
                                <option value="Pending">Pending</option>
                                <option value="Processing">Processing</option>
                                <option value="Shipped">Shipped</option>
                                <option value="Delivered">Delivered</option>
                                <option value="Cancelled">Cancelled</option>
                            </InputSelect>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success me-2">Save</button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelOrderForm">Cancel</button>
                </EditForm>
            </div>
        </div>
    }

    @if (!customer.Orders.Any())
    {
        <p class="text-muted">No orders yet for this customer.</p>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Order #</th>
                    <th>Description</th>
                    <th>Amount</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in customer.Orders.OrderByDescending(o => o.OrderDate))
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.Description</td>
                        <td>@order.Amount.ToString("C")</td>
                        <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            <span class="badge @GetStatusBadgeClass(order.Status)">@order.Status</span>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-warning me-1" @onclick="() => EditOrder(order)">Edit</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteOrder(order.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter]
    public int CustomerId { get; set; }

    private Customer? customer;
    private Order editingOrder = new();
    private bool showOrderForm;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomer();
    }

    private async Task LoadCustomer()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        customer = await db.Customers
            .Include(c => c.Orders)
            .FirstOrDefaultAsync(c => c.Id == CustomerId);

        if (customer == null)
        {
            Nav.NavigateTo("/");
        }
    }

    private void ShowAddOrderForm()
    {
        editingOrder = new Order { CustomerId = CustomerId, OrderDate = DateTime.UtcNow };
        showOrderForm = true;
    }

    private void EditOrder(Order order)
    {
        editingOrder = new Order
        {
            Id = order.Id,
            Description = order.Description,
            Amount = order.Amount,
            OrderDate = order.OrderDate,
            Status = order.Status,
            CustomerId = order.CustomerId
        };
        showOrderForm = true;
    }

    private void CancelOrderForm()
    {
        showOrderForm = false;
    }

    private async Task SaveOrder()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        if (editingOrder.Id == 0)
        {
            editingOrder.CustomerId = CustomerId;
            db.Orders.Add(editingOrder);
        }
        else
        {
            var existing = await db.Orders.FindAsync(editingOrder.Id);
            if (existing != null)
            {
                existing.Description = editingOrder.Description;
                existing.Amount = editingOrder.Amount;
                existing.OrderDate = editingOrder.OrderDate;
                existing.Status = editingOrder.Status;
            }
        }

        await db.SaveChangesAsync();
        showOrderForm = false;
        await LoadCustomer();
    }

    private async Task DeleteOrder(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var order = await db.Orders.FindAsync(id);
        if (order != null)
        {
            db.Orders.Remove(order);
            await db.SaveChangesAsync();
        }
        await LoadCustomer();
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "bg-warning text-dark",
        "Processing" => "bg-info text-dark",
        "Shipped" => "bg-primary",
        "Delivered" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}
