@page "/customer/{CustomerId:int}"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav

@if (customer == null)
{
    <FluentProgress />
}
else
{
    <FluentBreadcrumb>
        <FluentBreadcrumbItem Href="/">Customers</FluentBreadcrumbItem>
        <FluentBreadcrumbItem>@customer.FirstName @customer.LastName</FluentBreadcrumbItem>
    </FluentBreadcrumb>
    <br />

    <FluentCard Style="padding: 20px; margin-bottom: 16px;">
        <FluentLabel Typo="Typography.PageTitle">@customer.FirstName @customer.LastName</FluentLabel>
        <br />
        <FluentGrid Spacing="3">
            <FluentGridItem xs="12" sm="4">
                <FluentLabel Typo="Typography.Body"><strong>Email:</strong> @customer.Email</FluentLabel>
            </FluentGridItem>
            <FluentGridItem xs="12" sm="4">
                <FluentLabel Typo="Typography.Body"><strong>Phone:</strong> @(customer.Phone ?? "—")</FluentLabel>
            </FluentGridItem>
            <FluentGridItem xs="12" sm="4">
                <FluentLabel Typo="Typography.Body"><strong>Customer since:</strong> @customer.CreatedAt.ToString("yyyy-MM-dd")</FluentLabel>
            </FluentGridItem>
        </FluentGrid>
    </FluentCard>

    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" Style="margin-bottom: 16px;">
        <FluentLabel Typo="Typography.PageTitle">Orders</FluentLabel>
        <FluentButton Appearance="Appearance.Accent" OnClick="ShowAddOrderForm">
            <FluentIcon Value="new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.AddCircle()" Slot="start" />
            Add Order
        </FluentButton>
    </FluentStack>

    @if (showOrderForm)
    {
        <FluentCard Style="padding: 20px; margin-bottom: 16px;">
            <FluentLabel Typo="Typography.Subject">
                @(editingOrder.Id == 0 ? "New Order" : "Edit Order")
            </FluentLabel>
            <br />
            <EditForm Model="editingOrder" OnValidSubmit="SaveOrder">
                <DataAnnotationsValidator />
                <FluentGrid Spacing="3">
                    <FluentGridItem xs="12" sm="4">
                        <FluentTextField Label="Description" @bind-Value="editingOrder.Description" Required Style="width: 100%;" />
                    </FluentGridItem>
                    <FluentGridItem xs="12" sm="2">
                        <FluentNumberField TValue="decimal" Label="Amount" @bind-Value="editingOrder.Amount" Style="width: 100%;" />
                    </FluentGridItem>
                    <FluentGridItem xs="12" sm="3">
                        <FluentDatePicker Label="Order Date" @bind-Value="orderDate" Style="width: 100%;" />
                    </FluentGridItem>
                    <FluentGridItem xs="12" sm="3">
                        <FluentSelect Label="Status" @bind-Value="editingOrder.Status" Items="@statusOptions" OptionValue="@(s => s)" OptionText="@(s => s)" Style="width: 100%;" />
                    </FluentGridItem>
                </FluentGrid>
                <br />
                <FluentStack Orientation="Orientation.Horizontal">
                    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent">Save</FluentButton>
                    <FluentButton Appearance="Appearance.Outline" OnClick="CancelOrderForm">Cancel</FluentButton>
                </FluentStack>
            </EditForm>
        </FluentCard>
    }

    @if (!customer.Orders.Any())
    {
        <FluentLabel>No orders yet for this customer.</FluentLabel>
    }
    else
    {
        <FluentDataGrid Items="@customer.Orders.OrderByDescending(o => o.OrderDate).AsQueryable()" GridTemplateColumns="0.5fr 1.5fr 0.8fr 0.8fr 0.8fr 1fr" Style="width: 100%;">
            <PropertyColumn Title="Order #" Property="@(o => o.Id)" />
            <PropertyColumn Title="Description" Property="@(o => o.Description)" />
            <PropertyColumn Title="Amount" Property="@(o => o.Amount)" Format="C" />
            <PropertyColumn Title="Date" Property="@(o => o.OrderDate.ToString("yyyy-MM-dd"))" />
            <TemplateColumn Title="Status">
                <FluentBadge Appearance="@GetStatusAppearance(context.Status)">@context.Status</FluentBadge>
            </TemplateColumn>
            <TemplateColumn Title="Actions">
                <FluentStack Orientation="Orientation.Horizontal">
                    <FluentButton Appearance="Appearance.Outline" OnClick="@(() => EditOrder(context))">Edit</FluentButton>
                    <FluentButton Appearance="Appearance.Outline" OnClick="@(() => DeleteOrder(context.Id))">
                        <FluentIcon Value="new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Delete()" Color="Color.Error" />
                    </FluentButton>
                </FluentStack>
            </TemplateColumn>
        </FluentDataGrid>
    }
}

@code {
    [Parameter]
    public int CustomerId { get; set; }

    private Customer? customer;
    private Order editingOrder = new();
    private bool showOrderForm;

    private DateTime? orderDate
    {
        get => editingOrder.OrderDate;
        set => editingOrder.OrderDate = value ?? DateTime.UtcNow;
    }

    private static readonly string[] statusOptions = { "Pending", "Processing", "Shipped", "Delivered", "Cancelled" };

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomer();
    }

    private async Task LoadCustomer()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        customer = await db.Customers
            .Include(c => c.Orders)
            .FirstOrDefaultAsync(c => c.Id == CustomerId);

        if (customer == null)
        {
            Nav.NavigateTo("/");
        }
    }

    private void ShowAddOrderForm()
    {
        editingOrder = new Order { CustomerId = CustomerId, OrderDate = DateTime.UtcNow };
        showOrderForm = true;
    }

    private void EditOrder(Order order)
    {
        editingOrder = new Order
        {
            Id = order.Id,
            Description = order.Description,
            Amount = order.Amount,
            OrderDate = order.OrderDate,
            Status = order.Status,
            CustomerId = order.CustomerId
        };
        showOrderForm = true;
    }

    private void CancelOrderForm()
    {
        showOrderForm = false;
    }

    private async Task SaveOrder()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        if (editingOrder.Id == 0)
        {
            editingOrder.CustomerId = CustomerId;
            db.Orders.Add(editingOrder);
        }
        else
        {
            var existing = await db.Orders.FindAsync(editingOrder.Id);
            if (existing != null)
            {
                existing.Description = editingOrder.Description;
                existing.Amount = editingOrder.Amount;
                existing.OrderDate = editingOrder.OrderDate;
                existing.Status = editingOrder.Status;
            }
        }

        await db.SaveChangesAsync();
        showOrderForm = false;
        await LoadCustomer();
    }

    private async Task DeleteOrder(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var order = await db.Orders.FindAsync(id);
        if (order != null)
        {
            db.Orders.Remove(order);
            await db.SaveChangesAsync();
        }
        await LoadCustomer();
    }

    private static Appearance GetStatusAppearance(string status) => status switch
    {
        "Pending" => Appearance.Lightweight,
        "Processing" => Appearance.Accent,
        "Shipped" => Appearance.Accent,
        "Delivered" => Appearance.Accent,
        "Cancelled" => Appearance.Neutral,
        _ => Appearance.Neutral
    };
}
