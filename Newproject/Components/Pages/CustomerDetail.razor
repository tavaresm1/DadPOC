@page "/customer/{CustomerId:int}"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav

@if (customer == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="text-muted mt-2">Loading customer...</p>
    </div>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Customers</a></li>
            <li class="breadcrumb-item active">@customer.FirstName @customer.LastName</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex align-items-center">
                <div class="avatar avatar-lg me-4">
                    @customer.FirstName[0]@customer.LastName[0]
                </div>
                <div class="flex-grow-1">
                    <h3 class="mb-1">@customer.FirstName @customer.LastName</h3>
                    <div class="row text-muted">
                        <div class="col-auto">
                            <i class="bi bi-envelope me-1"></i> @customer.Email
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-telephone me-1"></i> @(customer.Phone ?? "—")
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-calendar me-1"></i> Customer since @customer.CreatedAt.ToString("MMM dd, yyyy")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">Orders</h4>
            <small class="text-muted">@customer.Orders.Count order@(customer.Orders.Count != 1 ? "s" : "") total</small>
        </div>
        <button class="btn btn-primary" @onclick="ShowAddOrderForm">
            <i class="bi bi-bag-plus me-1"></i> Add Order
        </button>
    </div>

    @if (showOrderForm)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0">
                    <i class="bi @(editingOrder.Id == 0 ? "bi-bag-plus" : "bi-pencil") me-2"></i>
                    @(editingOrder.Id == 0 ? "New Order" : "Edit Order")
                </h5>
            </div>
            <div class="card-body">
                <EditForm Model="editingOrder" OnValidSubmit="SaveOrder">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Description</label>
                            <InputText class="form-control" @bind-Value="editingOrder.Description" placeholder="Order description" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <InputNumber class="form-control" @bind-Value="editingOrder.Amount" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Order Date</label>
                            <InputDate class="form-control" @bind-Value="editingOrder.OrderDate" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Status</label>
                            <InputSelect class="form-select" @bind-Value="editingOrder.Status">
                                <option value="Pending">Pending</option>
                                <option value="Processing">Processing</option>
                                <option value="Shipped">Shipped</option>
                                <option value="Delivered">Delivered</option>
                                <option value="Cancelled">Cancelled</option>
                            </InputSelect>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-success me-2">
                            <i class="bi bi-check-lg me-1"></i> Save
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelOrderForm">
                            <i class="bi bi-x-lg me-1"></i> Cancel
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (!customer.Orders.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-bag display-1 text-muted"></i>
            <p class="text-muted mt-3">No orders yet. Click <strong>"Add Order"</strong> to create one.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr class="table-light">
                            <th>#</th>
                            <th>Description</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in customer.Orders.OrderByDescending(o => o.OrderDate))
                        {
                            <tr>
                                <td class="fw-semibold text-muted">#@order.Id</td>
                                <td>@order.Description</td>
                                <td class="fw-semibold">@order.Amount.ToString("C")</td>
                                <td class="text-muted">@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="badge rounded-pill @GetStatusBadgeClass(order.Status)">
                                        <i class="bi @GetStatusIcon(order.Status) me-1"></i>@order.Status
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => EditOrder(order)" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteOrder(order.Id)" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public int CustomerId { get; set; }

    private Customer? customer;
    private Order editingOrder = new();
    private bool showOrderForm;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomer();
    }

    private async Task LoadCustomer()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        customer = await db.Customers
            .Include(c => c.Orders)
            .FirstOrDefaultAsync(c => c.Id == CustomerId);

        if (customer == null)
        {
            Nav.NavigateTo("/");
        }
    }

    private void ShowAddOrderForm()
    {
        editingOrder = new Order { CustomerId = CustomerId, OrderDate = DateTime.UtcNow };
        showOrderForm = true;
    }

    private void EditOrder(Order order)
    {
        editingOrder = new Order
        {
            Id = order.Id,
            Description = order.Description,
            Amount = order.Amount,
            OrderDate = order.OrderDate,
            Status = order.Status,
            CustomerId = order.CustomerId
        };
        showOrderForm = true;
    }

    private void CancelOrderForm()
    {
        showOrderForm = false;
    }

    private async Task SaveOrder()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        if (editingOrder.Id == 0)
        {
            editingOrder.CustomerId = CustomerId;
            db.Orders.Add(editingOrder);
        }
        else
        {
            var existing = await db.Orders.FindAsync(editingOrder.Id);
            if (existing != null)
            {
                existing.Description = editingOrder.Description;
                existing.Amount = editingOrder.Amount;
                existing.OrderDate = editingOrder.OrderDate;
                existing.Status = editingOrder.Status;
            }
        }

        await db.SaveChangesAsync();
        showOrderForm = false;
        await LoadCustomer();
    }

    private async Task DeleteOrder(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var order = await db.Orders.FindAsync(id);
        if (order != null)
        {
            db.Orders.Remove(order);
            await db.SaveChangesAsync();
        }
        await LoadCustomer();
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "bg-warning text-dark",
        "Processing" => "bg-info text-dark",
        "Shipped" => "bg-primary",
        "Delivered" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };

    private static string GetStatusIcon(string status) => status switch
    {
        "Pending" => "bi-clock",
        "Processing" => "bi-gear",
        "Shipped" => "bi-truck",
        "Delivered" => "bi-check-circle",
        "Cancelled" => "bi-x-circle",
        _ => "bi-question-circle"
    };
}
