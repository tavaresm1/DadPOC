@inherits LayoutComponentBase

<div class="page-wrapper">
    <header class="app-header">
        <div class="header-content">
            <span class="ship-icon">&#9973;</span>
            <h1>Cruise Experience Survey</h1>
            <p class="subtitle">We value your feedback — help us make your next voyage even better!</p>
        </div>
        <nav class="header-nav">
            <a href="/" class="nav-link">Take Survey</a>
            <a href="/results" class="nav-link">View Results</a>
        </nav>
    </header>

    <main class="main-content">
        @Body
    </main>

    <footer class="app-footer">
        <p>Thank you for choosing to sail with us. Your feedback matters.</p>
    </footer>
</div>
